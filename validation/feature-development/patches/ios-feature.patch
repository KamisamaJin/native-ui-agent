+/// Upload progress uses an explicit track from the design instead of OS-default gray.
+@available(iOS 14, macOS 11, *)
+fileprivate struct UploadProgressStyle: ProgressViewStyle {
+    @Environment(\.colorScheme) private var colorScheme
+
+    func makeBody(configuration: Configuration) -> some View {
+        GeometryReader { geometry in
+            ZStack(alignment: .leading) {
+                Capsule().fill(colorScheme == .dark
+                    ? Color.blue.opacity(0.25)
+                    : Color(red: 221 / 255, green: 234 / 255, blue: 1))
+                Capsule().fill(Color.blue)
+                    .frame(width: geometry.size.width * CGFloat(configuration.fractionCompleted ?? 0))
+            }
+        }
+    }
+}
