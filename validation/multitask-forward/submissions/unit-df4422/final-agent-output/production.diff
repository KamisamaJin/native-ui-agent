+private struct PackSelectionSeed: Equatable {
+    let requestID: String
+    let selectedIDs: Set<String>
+    let cover: Bool
+
+    init(request: ExpeditionPackRequest) {
+        requestID = request.id
+        let available = Set(request.items.filter { $0.available }.map { $0.id })
+        selectedIDs = Set(request.selectedIDs).intersection(available)
+        cover = request.cover && !selectedIDs.isEmpty
+    }
+
+    // Only a new request identity resets the local choices. The change value
+    // carries that request's seed without reading a captured earlier request.
+    static func == (lhs: PackSelectionSeed, rhs: PackSelectionSeed) -> Bool {
+        lhs.requestID == rhs.requestID
+    }
+}
+
+private struct PackButtonStyle: ButtonStyle {
