+private struct PackRequestSeed: Equatable {
+    let requestID: String
+    let selectedIDs: Set<String>
+    let cover: Bool
+
+    // Only a new request identity resets local choices; use its incoming seed payload.
+    static func == (lhs: PackRequestSeed, rhs: PackRequestSeed) -> Bool {
+        lhs.requestID == rhs.requestID
+    }
