{
  "width": 390,
  "theme": "light",
  "direction": "ltr",
  "dynamic_type": "large",
  "fontScale": 1.0,
  "viewportHeight": 600,
  "initial": {
    "title": "Capability initial",
    "detail": "Initial detail"
  },
  "updates": [
    {
      "title": "Capability updated",
      "detail": "Updated detail"
    }
  ],
  "max_scrolls": 24,
  "required_identifiers": [
    "probe.title",
    "probe.primary",
    "probe.last",
    "probe.detail"
  ],
  "actions": [
    {
      "type": "tap",
      "target": {
        "identifier": "probe.primary"
      },
      "reveal": true,
      "expect_callback": "probe.primary",
      "state_id": "primary"
    },
    {
      "type": "apply_next_fixture",
      "state_id": "updated"
    },
    {
      "type": "tap",
      "target": {
        "identifier": "probe.last"
      },
      "reveal": true,
      "expect_callback": "probe.last",
      "state_id": "last"
    }
  ]
}
