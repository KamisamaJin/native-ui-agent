      "kind": "event",
      "coverage": "target"
    },
    {
      "id": "replacement-callback-quiet",
      "kind": "event",
      "stimulus": "caller_update",
      "coverage": "target"
    },
    {
      "id": "primary-control-height",
      "kind": "geometry",
      "target": "submit",
      "property": "height",
      "op": "gte",
      "basis": "control",
