      "coverage": "target"
    },
    {
      "id": "title-native-weight",
      "kind": "text_layout",
      "target": "title",
      "property": "font_weight",
      "coverage": "target"
    },
    {
      "id": "component-canvas-color",
      "kind": "manual",
      "target": "canvas",
      "property": "rendered_canvas_argb",
      "allowed_methods": [
        "native_pixels"
      ],
      "coverage": "target"
    },
    {
      "id": "notice-surface-color",
      "kind": "manual",
      "target": "notice",
      "property": "rendered_fill_argb",
      "allowed_methods": [
        "native_pixels"
      ],
      "coverage": "target"
    },
    {
      "id": "primary-surface-color",
      "kind": "manual",
      "target": "submit",
      "property": "rendered_fill_argb",
      "allowed_methods": [
        "native_pixels"
      ],
      "coverage": "target"
    },
    {
      "id": "content-wrapping",
      "kind": "manual",
      "target": "canvas",
      "property": "wrapping",
      "allowed_methods": [
        "visual"
      ],
      "coverage": "full_content"
    },
    {
      "id": "content-overlap",
      "kind": "manual",
      "target": "canvas",
      "property": "overlap",
      "allowed_methods": [
        "visual"
      ],
      "coverage": "full_content"
    }
