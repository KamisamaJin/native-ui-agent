  "obligations": [
    {
      "id": "caller-content",
      "clause": "Every caller title, order summary and live status reflects the current order.",
      "priority": "must",
      "states": [
        "ready",
        "notes_open",
        "delegate_chosen",
        "authorized",
        "submitted",
        "replacement"
      ],
      "risk": "content"
    },
    {
      "id": "notes-content",
      "clause": "Disclosure reflects state; the exact full body appears only while open.",
      "priority": "must",
      "states": [
        "ready",
        "notes_open",
        "delegate_chosen",
        "authorized",
        "submitted",
        "replacement"
      ],
      "risk": "content"
    },
    {
      "id": "collector-state",
      "clause": "Native selected traits and both choice enabled states follow current selection, submission and caller availability.",
      "priority": "must",
      "states": [
        "ready",
        "notes_open",
        "delegate_chosen",
        "authorized",
        "submitted",
        "replacement"
      ],
      "risk": "behavior"
    },
    {
      "id": "ack-visibility",
      "clause": "Only a delegate selection reveals the native acknowledgment switch.",
      "priority": "must",
      "states": [
        "ready",
        "notes_open",
        "delegate_chosen",
        "authorized",
        "submitted",
        "replacement"
      ],
      "risk": "behavior"
    },
    {
      "id": "ack-state",
      "clause": "Delegate acknowledgment exposes the full caller label and actual native Boolean value.",
      "priority": "must",
      "states": [
        "delegate_chosen",
        "authorized",
        "submitted"
      ],
      "risk": "behavior"
    },
    {
      "id": "primary-state",
      "clause": "Primary label, enabled state and native measured minimum height follow validity and submission.",
      "priority": "must",
      "states": [
        "ready",
        "notes_open",
        "delegate_chosen",
        "authorized",
        "submitted",
        "replacement"
      ],
      "risk": "behavior"
    },
    {
      "id": "notes-callback",
      "clause": "Opening notes emits the exact request-bound event once after successful native activation.",
      "priority": "must",
      "states": [
        "notes_open"
      ],
      "risk": "behavior"
    },
    {
      "id": "collector-callback",
      "clause": "Choosing delegate emits the exact request-bound event once after successful native activation.",
      "priority": "must",
      "states": [
        "delegate_chosen"
      ],
      "risk": "behavior"
    },
    {
      "id": "ack-callback",
      "clause": "Acknowledgment emits the exact request-bound event once after successful native activation.",
      "priority": "must",
      "states": [
        "authorized"
      ],
      "risk": "behavior"
    },
    {
      "id": "submit-callback",
      "clause": "Confirmation emits one exact request-bound submit event after successful native activation.",
      "priority": "must",
      "states": [
        "submitted"
      ],
      "risk": "behavior"
    },
    {
      "id": "caller-replacement",
      "clause": "The same-process caller replacement emits no event; the separately checked replacement state has reset labels, choices and local state.",
      "priority": "must",
      "states": [
        "replacement"
      ],
      "risk": "behavior"
    },
    {
      "id": "choice-size",
