      "requestID": {
        "value": "PRINT-7316",
        "unit": "string"
      },
      "title": {
        "value": "Authorize collection for the neighbourhood exhibition",
        "unit": "string"
      },
      "jobSummary": {
        "value": "North Quays Community Archive · 64 large-print catalogues and six folded location maps",
        "unit": "string"
      },
      "pickupWindow": {
        "value": "Collect Saturday 31 October, 09:30–11:45 · Accessible side entrance beside the loading courtyard",
        "unit": "string"
      },
      "notesClosedTitle": {
        "value": "Show pickup notes",
        "unit": "string"
      },
      "notesOpenTitle": {
        "value": "Hide pickup notes",
        "unit": "string"
      },
      "notesBody": {
        "value": "Keep this collection reference available when you arrive. The counter team will check the job number before handing over the sealed cartons.\n\nThe programmes are packed flat in three reusable cartons. Please bring a trolley or ask the counter team for help before moving the full order to your vehicle.\n\nIf someone collects for you, they must show their own photo ID and quote the same collection reference. This authorization covers collection only; it does not allow changes to artwork, quantities, or payment details.\n\nCheck the carton labels before leaving. If a carton looks damaged or a quantity differs from the packing slip, keep it at the counter so the team can record the issue with you.\n\nUncollected print work is stored indoors for seven calendar days. Contact the shop before the end of that period if your event has moved, because bulky orders may require a new collection arrangement.\n\nThe accessible entrance is reached from the courtyard rather than the main pavement. A staff member can bring the order to that entrance if the collector asks at the door. Leave the route clear for other visitors while cartons are checked.",
        "unit": "string"
      },
      "selfTitle": {
        "value": "I will collect the complete order",
        "unit": "string"
      },
      "selfDetail": {
        "value": "The counter team will check the order name and collection reference together",
        "unit": "string"
      },
      "delegateTitle": {
        "value": "A colleague will collect on my behalf",
        "unit": "string"
      },
      "delegateDetail": {
        "value": "They need their own photo ID, this reference, and space for all cartons",
        "unit": "string"
      },
      "acknowledgement": {
        "value": "I have given my colleague the full collection reference, the photo ID requirement, and the accessible entrance instructions.",
        "unit": "string"
      },
      "confirmTitle": {
        "value": "Confirm collection authorization",
        "unit": "string"
