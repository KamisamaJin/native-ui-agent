  "obligations": [
    {
      "id": "caller-content",
      "clause": "Every caller title, order summary, pickup window and live status reflects the current order.",
      "priority": "must",
      "states": [
        "ready",
        "notes_open",
        "delegate_chosen",
        "authorized",
        "submitted",
        "replacement"
      ],
      "risk": "content"
    },
    {
      "id": "notes-content",
      "clause": "Disclosure reflects state; the exact full body appears only while open.",
      "priority": "must",
      "states": [
        "ready",
        "notes_open",
        "delegate_chosen",
        "authorized",
        "submitted",
        "replacement"
      ],
      "risk": "content"
    },
    {
      "id": "collector-state",
      "clause": "Native selected traits and both choice enabled states follow current selection, submission and caller availability.",
      "priority": "must",
      "states": [
        "ready",
        "notes_open",
        "delegate_chosen",
        "authorized",
        "submitted",
        "replacement"
      ],
      "risk": "behavior"
    },
    {
      "id": "ack-visibility",
      "clause": "Only a delegate selection reveals the native acknowledgment switch.",
      "priority": "must",
      "states": [
        "ready",
        "notes_open",
        "delegate_chosen",
        "authorized",
        "submitted",
        "replacement"
      ],
      "risk": "behavior"
    },
    {
      "id": "ack-state",
      "clause": "Delegate acknowledgment exposes its full caller label and native Boolean value, remains enabled before submission, and is disabled after submission.",
      "priority": "must",
      "states": [
        "delegate_chosen",
        "authorized",
        "submitted"
      ],
      "risk": "behavior"
    },
    {
      "id": "primary-state",
      "clause": "Primary label, enabled state and native measured minimum height follow validity and submission.",
      "priority": "must",
      "states": [
        "ready",
        "notes_open",
        "delegate_chosen",
        "authorized",
        "submitted",
        "replacement"
      ],
      "risk": "behavior"
    },
    {
      "id": "notes-callback",
      "clause": "Opening notes emits the exact request-bound event once after successful native activation.",
      "priority": "must",
      "states": [
        "notes_open"
      ],
      "risk": "behavior"
    },
    {
      "id": "collector-callback",
      "clause": "Choosing delegate emits the exact request-bound event once after successful native activation.",
      "priority": "must",
      "states": [
        "delegate_chosen"
      ],
      "risk": "behavior"
    },
    {
      "id": "ack-callback",
      "clause": "Acknowledgment emits the exact request-bound event once after successful native activation.",
      "priority": "must",
      "states": [
        "authorized"
      ],
      "risk": "behavior"
    },
    {
      "id": "submit-callback",
      "clause": "Confirmation emits one exact request-bound submit event after successful native activation.",
      "priority": "must",
      "states": [
        "submitted"
      ],
      "risk": "behavior"
    },
    {
      "id": "caller-replacement",
      "clause": "The same-process caller replacement emits no event; the separately checked replacement state has reset labels, choices and local state.",
      "priority": "must",
      "states": [
        "replacement"
      ],
      "risk": "behavior"
    },
    {
      "id": "choice-size",
      "clause": "Delegate Button native accessibility/control boundary is at least 80 native units high and may grow for content.",
      "priority": "must",
      "states": [
        "ready",
        "notes_open",
        "delegate_chosen",
        "authorized",
        "submitted",
        "replacement"
      ],
      "risk": "layout"
    },
    {
      "id": "choice-color",
      "clause": "Delegate Button has the exact opaque theme-aware selected or neutral fill in the approved visible solid region.",
      "priority": "must",
      "states": [
        "ready",
        "notes_open",
        "delegate_chosen",
        "authorized",
        "submitted",
        "replacement"
      ],
      "risk": "style"
    },
    {
      "id": "overlap",
      "clause": "All content and controls remain clear of unintended overlap in full-content scans.",
      "priority": "must",
      "states": [
        "ready",
        "notes_open",
        "delegate_chosen",
        "authorized",
        "submitted",
        "replacement"
      ],
      "risk": "layout"
    },
    {
      "id": "wrapping",
      "clause": "Displayed labels and paragraphs remain within content width, wrapping without clipping or ellipsis.",
      "priority": "must",
      "states": [
        "ready",
        "notes_open",
        "delegate_chosen",
        "authorized",
        "submitted",
        "replacement"
      ],
      "risk": "layout"
    },
    {
      "id": "collector-content",
      "clause": "Each visible choice row exposes both exact caller-provided title and detail substrings for the current order.",
      "priority": "must",
      "states": [
        "ready",
        "notes_open",
        "delegate_chosen",
        "authorized",
        "submitted",
