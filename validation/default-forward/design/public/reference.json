      "title": {
        "value": "Authorize print collection",
        "unit": "string"
      },
      "jobSummary": {
        "value": "Cedar Street Choir · 120 concert programmes",
        "unit": "string"
      },
      "pickupWindow": {
        "value": "Collect Thu 29 Oct, 16:00–18:30 · Front counter",
        "unit": "string"
      },
      "notesClosedTitle": {
        "value": "Show pickup notes",
        "unit": "string"
      },
      "notesOpenTitle": {
        "value": "Hide pickup notes",
        "unit": "string"
      },
      "notesBody": {
        "value": "Keep this collection reference available when you arrive. The counter team will check the job number before handing over the sealed cartons.\n\nThe programmes are packed flat in three reusable cartons. Please bring a trolley or ask the counter team for help before moving the full order to your vehicle.\n\nIf someone collects for you, they must show their own photo ID and quote the same collection reference. This authorization covers collection only; it does not allow changes to artwork, quantities, or payment details.\n\nCheck the carton labels before leaving. If a carton looks damaged or a quantity differs from the packing slip, keep it at the counter so the team can record the issue with you.\n\nUncollected print work is stored indoors for seven calendar days. Contact the shop before the end of that period if your event has moved, because bulky orders may require a new collection arrangement.",
        "unit": "string"
      },
      "selfTitle": {
        "value": "I will collect",
        "unit": "string"
      },
      "selfDetail": {
        "value": "Use my order name at the counter",
        "unit": "string"
      },
      "delegateTitle": {
        "value": "Someone else will collect",
        "unit": "string"
      },
      "delegateDetail": {
        "value": "Their photo ID and this reference are required",
        "unit": "string"
      },
      "acknowledgement": {
        "value": "I have shared the collection reference and ID requirement with my collector.",
        "unit": "string"
      },
      "confirmTitle": {
        "value": "Confirm collection authorization",
        "unit": "string"
