{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Anonymous native evaluation normalization (raw evidence retained)",
  "type":"object",
  "required":["schemaVersion","anonymousID","stage","rawEvidence","records"],
  "properties":{
    "schemaVersion":{"const":1},
    "anonymousID":{"type":"string"},
    "stage":{"enum":["D0","FINAL","selfreview","paired-D0"]},
    "rawEvidence":{"type":"array","items":{"type":"string"}},
    "records":{"type":"array","items":{
      "type":"object",
      "required":["cellID","evidenceKind","evidenceRefs","context"],
      "properties":{
        "cellID":{"type":"string"},
        "actual":{},
        "uncertainty":{"type":"number","minimum":0},
        "evidenceKind":{"enum":["native.text","native.name","native.enabled","native.selected","native.expanded","native.presence","native.bounds","native.fontSize","native.fontWeight","native.color","native.scalar","native.coverage","native.physicalHit","native.transition","native.events","native.stimulus","manual.screenshot","manual.source","input.integrity"]},
        "evidenceRefs":{"type":"array","minItems":1,"items":{"type":"string"}},
        "context":{"type":"object","properties":{"platform":{"enum":["android","ios","host"]},"caseID":{"type":["string","null"]},"stateID":{"type":["string","null"]},"processID":{"type":"string"},"inputRevision":{"type":["string","integer"]},"eventRevision":{"type":["string","integer"]},"mappingRef":{"type":"string"}}},
        "helperVerdict":{"enum":["pass","fail","unknown"]},
        "helperReason":{"type":"string"},
        "gate":{"type":"object","required":["verdict","kind","evidenceRefs"],"properties":{"verdict":{"enum":["pass","fail","unknown"]},"kind":{"enum":["successfulExactActivation","replacementApplied"]},"evidenceRefs":{"type":"array","minItems":1,"items":{"type":"string"}},"attempts":{"type":"integer"},"intervalComplete":{"type":"boolean"},"targetID":{"type":"string"}}},
        "reviewVerdict":{"enum":["pass","fail","unknown"]},
        "reviewReason":{"type":"string"},
        "completeCoverage":{"type":"boolean"}
      }
    }}
  }
}
