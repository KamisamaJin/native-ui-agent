{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisitorAccessInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "entityID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "title": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "guestCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "sponsorActive": {
      "type": "boolean"
    },
    "badgeTrainingComplete": {
      "type": "boolean"
    },
    "researchCapacity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "officeCapacity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "verifiedIDs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "labInductions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "escortCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    }
  },
  "required": [
    "entityID",
    "revision",
    "title",
    "context",
    "notes",
    "guestCount",
    "sponsorActive",
    "badgeTrainingComplete",
    "researchCapacity",
    "officeCapacity",
    "verifiedIDs",
    "labInductions",
    "escortCount"
  ]
}
