      "entityId": "INV-640",
      "entityTitle": "Workshop materials invoice",
      "description": "Allocate the available account credit before choosing how to settle the remaining amount. This invoice includes reusable workshop supplies, documented delivery charges, and a separate reference for the accounts team. Amounts are integer US cents; never calculate using binary floating-point money.",
      "dueCents": 12500,
      "creditCents": 4500,
      "methods": [
        {
          "id": "bank",
          "label": "Pay by bank transfer",
          "detail": "Use the verified operating account ending 0428. The payment reference must remain attached to this invoice.",
          "available": true,
          "unavailableReason": ""
        },
        {
          "id": "card",
          "label": "Pay by company card",
          "detail": "The company card is temporarily unavailable for this supplier.",
          "available": false,
          "unavailableReason": "Supplier card payments paused"
        }
      ]
    },
