{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidateDispositionInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "entityID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "portfolioScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "reviewerCapacity": {
      "type": "integer",
      "minimum": 0
    },
    "technicalSlots": {
      "type": "integer",
      "minimum": 0
    },
    "recruiterSlots": {
      "type": "integer",
      "minimum": 0
    },
    "legalHold": {
      "type": "boolean"
    },
    "assessmentCount": {
      "type": "integer",
      "minimum": 0
    },
    "openRoleCount": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "entityID",
    "revision",
    "title",
    "context",
    "notes",
    "portfolioScore",
    "reviewerCapacity",
    "technicalSlots",
    "recruiterSlots",
    "legalHold",
    "assessmentCount",
    "openRoleCount"
  ]
}
