  "initial": {
    "entityId": "RET-517",
    "entityTitle": "Portable interpretation tablet return",
    "description": "Record the physical checks before routing this returned tablet. A return can be offered for stock only after its power test, accessories count, and required data erasure are complete. Keep the original complaint and the next handling instruction visible for the receiving team.",
    "dataBearing": true,
    "restockAllowed": true,
    "repairAllowed": true,
    "recycleAllowed": false,
    "restockDetail": "Restock only after the tablet passes the power test and its data and accessories checks are complete.",
    "repairDetail": "A technician can inspect the intermittent charging fault after safe intake checks.",
    "recycleDetail": "Recycling is unavailable while this model remains in the repair program."
  },
