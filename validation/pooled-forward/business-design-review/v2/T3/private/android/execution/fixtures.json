    "entityTitle": "Specialist accessible exhibition equipment and consolidated delivery",
    "description": "The supplier consolidated several small equipment lines into one invoice. Preserve the complete remittance instructions and the statement that account credit must be capped at the amount actually due. A one-cent difference matters to the balance, and the authorized method must be the currently available one rather than the first method in the supplied list.",
    "dueCents": 10199,
    "creditCents": 3333,
    "methods": [
      {
        "id": "bank",
        "label": "Pay by bank transfer",
        "detail": "Use the verified operating account ending 0428. The payment reference must remain attached to this invoice.",
        "available": false,
        "unavailableReason": "Bank verification pending"
      },
      {
        "id": "card",
        "label": "Pay by company card",
        "detail": "Use the purchasing card with the documented spending approval, and retain the unusually long supplier reference supplied with the invoice.",
