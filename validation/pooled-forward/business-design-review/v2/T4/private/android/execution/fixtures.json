{
  "initial": {
    "entityId": "INC-880",
    "entityTitle": "Regional membership and assisted-registration service interruption",
    "description": "Staff are supporting members who cannot complete assisted registration. The notice must retain the full explanation for people who saved a partially completed form, including the distinction between an unconfirmed request and a confirmed membership, and must not promise a recovery time that has not been provided by the incident owner.",
    "subject": "Assisted registration requests may need a staff review before confirmation",
    "message": "Requests saved during the interruption remain in the review queue. A saved request does not yet establish a confirmed membership. Staff should locate the original reference, explain the current status in plain language, and avoid asking a member to enter the same details repeatedly while the regional team checks the queue.",
    "workaround": "",
    "audiences": [
      {
        "id": "customers",
        "label": "Notify affected customers",
        "detail": "Customers with bookings awaiting confirmation need a direct explanation and a usable next step.",
        "recipients": 124,
        "allowed": false,
        "blockedReason": "Direct customer wording has not been approved"
      },
      {
        "id": "staff",
        "label": "Notify service staff",
        "detail": "Regional service staff, assisted-registration volunteers, and the named support coordinator need the full operational explanation for their next member conversation.",
        "recipients": 47,
        "allowed": true,
        "blockedReason": ""
      },
