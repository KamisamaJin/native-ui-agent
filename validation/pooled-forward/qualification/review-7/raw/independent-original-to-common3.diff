+      "x",
+      "y",
+      "width",
+      "height"
+    ],
+    "original_native_precision_and_unit_required": true,
+    "boolean_null_nonfinite_or_truncated_numeric_rejected": true,
+    "raw_values_preserved": true
+  },
+  "projection": {
+    "arithmetic": "Exact rational values of decoded native numbers and independently verified map parameters; no floating floor/ceil after cancellation",
+    "map": "u=sx*x+ox; v=sy*y+oy; a=sx*width; b=sy*height",
+    "requirements": [
+      "positive axis-aligned scale",
+      "fixed native coordinate origin and native-to-PNG provenance",
+      "no rotation/shear/fitted transform",
+      "actual viewport crop maps to integral PNG rectangle W x H",
+      "same W/H/color representation for the pair",
+      "raw native anchor strictly inside native viewport; no tolerant flag substitution"
+    ],
+    "not_source_of_truth": "A guessed image_frame, fitted density or viewport selected to improve pixel agreement"
+  },
+  "cell_enclosure": {
+    "Q": "Q(q)=[floor(q),ceil(q)]",
+    "integral_case": "singleton; do not add epsilon",
+    "meaning": "Conservative pixel-boundary enclosure of the exact recorded scalar, not measurement-error tolerance",
+    "native_fields_not_modified": true
+  },
+  "candidate_rectangle": {
+    "coordinates": "integer half-open [L,R) x [T,B)",
