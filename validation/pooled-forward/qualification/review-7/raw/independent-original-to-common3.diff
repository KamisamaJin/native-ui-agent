+def requested(root):
+    if root is None:return False
+    root=Path(root)
+    if any((root/name).exists()for name in ['coverage-domain-input.json','coverage-domain-binding.json']):return True
+    parent=root.parent
+    if (parent/'coverage-domain-prepared.json').exists():return True
+    request=parent/'request.json'
