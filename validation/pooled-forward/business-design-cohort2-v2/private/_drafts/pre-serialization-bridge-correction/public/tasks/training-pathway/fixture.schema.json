{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrainingPathwayInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "entityID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "title": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completedHours": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "completedModules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cohortSeats": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "deviceCredits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "assessmentSlots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "practiceSeats": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    }
  },
  "required": [
    "entityID",
    "revision",
    "title",
    "context",
    "notes",
    "completedHours",
    "completedModules",
    "cohortSeats",
    "deviceCredits",
    "assessmentSlots",
    "practiceSeats"
  ]
}
