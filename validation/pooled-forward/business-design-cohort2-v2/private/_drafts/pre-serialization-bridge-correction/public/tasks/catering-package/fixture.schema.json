{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CateringPackageInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "entityID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "title": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "guestCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "vegetarianGuests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "vegetarianMeals": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "buffetCapacity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "boxedCapacity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "reusableSets": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "compostableSets": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    }
  },
  "required": [
    "entityID",
    "revision",
    "title",
    "context",
    "notes",
    "guestCount",
    "vegetarianGuests",
    "vegetarianMeals",
    "buffetCapacity",
    "boxedCapacity",
    "reusableSets",
    "compostableSets"
  ]
}
