{
  "version": 1,
  "platform": "ios",
  "backend": "snapshot-testing",
  "target": {
    "description": "AlertToast.hud / long",
    "sources": [
      "Package.swift",
      "Sources/AlertToast",
      "Tests/AlertToastTests/AlertToastNativeUiTests.swift"
    ]
  },
  "environment": {
    "xcode": "27.1 (27A9275)",
    "runtime": "iOS 26.5",
    "device": "NativeUIPilot-iPhone17Pro / AB66271B-29BD-4D14-9C9B-71579E147DCA",
    "snapshot_testing": "1.19.2",
    "canvas_pt": [
      390,
      240
    ],
    "trait_display_scale": 2,
    "theme": "light",
    "content_size_category": "large"
  },
  "commands": [
    {
      "argv": [
        "python3",
        "/Users/rex/Documents/ChatGPT/mobile-native-skill/validation/native-ui-pilot/adapters/capture_ios.py",
        "--project",
        "/Users/rex/Documents/ChatGPT/mobile-native-skill/validation/native-ui-pilot/checkouts/alerttoast",
        "--output",
        "{output}",
        "--cache",
        "/Users/rex/Documents/ChatGPT/mobile-native-skill/validation/native-ui-pilot/cache/ios",
        "--device-id",
        "AB66271B-29BD-4D14-9C9B-71579E147DCA",
        "--scenario",
        "long"
      ],
      "env": {
        "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
      },
      "timeout_seconds": 1200
    }
  ],
  "artifacts": [
    {
      "base": "output",
      "glob": "native/actual.png",
      "role": "actual"
    },
    {
      "base": "output",
      "glob": "native/native-test.json",
      "role": "native-report"
    }
  ],
  "checks": [
    {
      "id": "hud-hierarchy",
      "kind": "visual",
      "description": "HUD的图标、标题、副标题有清楚的层级和留白，长文本可读，保持原有组件视觉设计",
      "source": "未修改的上游 AlertToast HUD；本试验要求保留原设计"
    }
  ],
  "protected_paths": []
}
