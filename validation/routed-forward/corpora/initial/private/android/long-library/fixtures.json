{
  "initial": {
    "sessionID": "weekend-rest",
    "title": "A small pocket of quiet between the busy parts of your day",
    "introduction": "Settle in at your own pace and choose a recording that feels comfortable today. Every soundscape has its own rhythm, and you are welcome to change your mind before beginning this listening break.",
    "options": [
      {
        "id": "brook",
        "title": "A winding woodland brook after the overnight rain",
        "detail": "Water moves over shallow stones while occasional birds call from deeper in the trees. There is no narration and no music, so the sound can leave plenty of space for your own thoughts.",
        "isAvailable": true
      },
      {
        "id": "hearth",
        "title": "A warm room beside the old library fireplace",
        "detail": "Low crackles, a little movement in the room, and quiet intervals between them. The recording was made from an armchair a comfortable distance from the fire.",
        "isAvailable": true
      },
      {
        "id": "meadow",
        "title": "The far meadow beyond the orchard wall",
        "detail": "This longer field recording is being prepared for the collection and cannot be selected yet. Another available soundscape can be chosen now.",
        "isAvailable": false
      }
    ],
    "quietNote": "Before starting, make sure you are somewhere you can rest without needing to watch for moving traffic, equipment, or other demands on your attention. Keep the volume comfortable enough to notice your surroundings, and stop the break whenever you need to.",
    "footer": "A listening break is simply an invitation to pause. There is no score to achieve, no timer you must complete, and no need to keep a particular pace. Your choice belongs to this local session, and this panel does not begin audio playback."
  },
  "updates": [
    {
      "sessionID": "weekend-rest",
      "title": "The sound library has new notes for this quiet moment",
      "introduction": "The descriptions have been refreshed while this panel stayed open. Read the new notes and make whichever choice suits you now; earlier choices are cleared so this session begins with the current information.",
      "options": [
        {
          "id": "brook",
          "title": "Woodland water near the little footbridge at dusk",
          "detail": "The same gentle stream heard later in the day, with longer quiet spaces between the calls of birds and a soft breeze passing through the trees beside the water.",
          "isAvailable": true
        },
        {
          "id": "hearth",
          "title": "An afternoon by the reading room hearth after the rain",
          "detail": "A little less crackle and a little more room tone, recorded while the building settled into a calm afternoon. Choose a comfortable volume before you begin.",
          "isAvailable": true
        },
        {
          "id": "meadow",
          "title": "Orchard meadow — preparation continues",
          "detail": "This recording is still unavailable while its listening notes are prepared.",
          "isAvailable": false
        }
      ],
      "quietNote": "Take another moment to check that your resting place and volume still feel comfortable. You can pause or leave whenever your surroundings need your attention.",
      "footer": "The new collection has replaced the earlier descriptions without opening a new panel. You can now choose again from the current soundscapes and confirm the updated quiet-space note."
    }
  ],
