    "kitchenNotes": [
      "\u062a\u0635\u0644 \u0627\u0644\u0635\u0648\u0627\u0646\u064a \u0625\u0644\u0649 \u0627\u0644\u0645\u062f\u062e\u0644 \u0627\u0644\u062c\u0627\u0646\u0628\u064a \u0645\u0639 \u0628\u0637\u0627\u0642\u0629 \u0645\u0633\u062a\u0642\u0644\u0629 \u0644\u0643\u0644 \u0637\u0628\u0642. \u064a\u0631\u062c\u0649 \u0645\u0637\u0627\u0628\u0642\u0629 \u0627\u0633\u0645 \u0627\u0644\u0637\u0628\u0642 \u0648\u0631\u0642\u0645 \u0627\u0644\u0637\u0644\u0628 \u0642\u0628\u0644 \u0646\u0642\u0644 \u0627\u0644\u0637\u0639\u0627\u0645 \u0625\u0644\u0649 \u0637\u0627\u0648\u0644\u0629 \u0627\u0644\u062e\u062f\u0645\u0629 \u0641\u064a \u0627\u0644\u0642\u0627\u0639\u0629.",
      "\u062a\u0628\u0642\u0649 \u0627\u0644\u0623\u063a\u0637\u064a\u0629 \u0645\u063a\u0644\u0642\u0629 \u062d\u062a\u0649 \u064a\u0628\u062f\u0623 \u0641\u0631\u064a\u0642 \u0627\u0644\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0639\u0645\u0644. \u0627\u0641\u062a\u062d\u0648\u0627 \u0635\u064a\u0646\u064a\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u064a \u0643\u0644 \u0645\u0631\u0629 \u0644\u0644\u0645\u062d\u0627\u0641\u0638\u0629 \u0639\u0644\u0649 \u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0623\u062c\u0632\u0627\u0621 \u0627\u0644\u0645\u062e\u0635\u0635\u0629 \u0644\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629.",
      "\u062a\u0648\u0636\u0639 \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0643\u0648\u0646\u0627\u062a \u0628\u062c\u0627\u0646\u0628 \u0623\u062f\u0648\u0627\u062a \u0627\u0644\u062a\u0642\u062f\u064a\u0645 \u0637\u0648\u0627\u0644 \u0648\u0642\u062a \u0627\u0644\u062e\u062f\u0645\u0629. \u0644\u0627 \u062a\u0646\u0642\u0644\u0648\u0627 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0625\u0644\u0649 \u0627\u0644\u0645\u0643\u062a\u0628 \u0642\u0628\u0644 \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0648\u062c\u0628\u0629 \u062d\u062a\u0649 \u064a\u0638\u0644 \u0648\u0635\u0641 \u0627\u0644\u0637\u0628\u0642 \u0645\u062a\u0627\u062d\u064b\u0627 \u0644\u0644\u0636\u064a\u0648\u0641.",
      "\u0627\u0633\u062a\u062e\u062f\u0645\u0648\u0627 \u0645\u0644\u0639\u0642\u0629 \u0645\u0646\u0641\u0635\u0644\u0629 \u0644\u0643\u0644 \u0635\u064a\u0646\u064a\u0629\u060c \u0648\u0627\u062a\u0631\u0643\u0648\u0627 \u0627\u0644\u0635\u0644\u0635\u0629 \u0641\u064a \u0648\u0639\u0627\u0626\u0647\u0627 \u0627\u0644\u0645\u0633\u062a\u0642\u0644. \u064a\u0631\u062c\u0649 \u0639\u062f\u0645 \u062a\u0628\u062f\u064a\u0644 \u0623\u062f\u0648\u0627\u062a \u0627\u0644\u062a\u0642\u062f\u064a\u0645 \u0628\u064a\u0646 \u0627\u0644\u0623\u0637\u0628\u0627\u0642 \u0639\u0646\u062f \u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0645\u0627\u0626\u062f\u0629.",
      "\u0639\u062f\u062f \u0627\u0644\u062d\u0635\u0635 \u0647\u0646\u0627 \u0647\u0648 \u0627\u0644\u0639\u062f\u062f \u0627\u0644\u0630\u064a \u0633\u064a\u062d\u0636\u0631\u0647 \u0627\u0644\u0645\u0637\u0628\u062e\u060c \u0648\u0642\u062f \u064a\u062e\u062a\u0644\u0641 \u0639\u0646 \u0639\u062f\u062f \u0627\u0644\u0645\u0642\u0627\u0639\u062f \u0641\u064a \u0627\u0644\u0642\u0627\u0639\u0629. \u0623\u062e\u0628\u0631\u0648\u0627 \u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u062e\u062f\u0645\u0629 \u0628\u0623\u064a \u062a\u063a\u064a\u064a\u0631 \u0642\u0628\u0644 \u0641\u062a\u062d \u0627\u0644\u0635\u064a\u0646\u064a\u0629 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629.",
      "\u064a\u0648\u0636\u0639 \u0635\u0646\u062f\u0648\u0642 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0635\u0648\u0627\u0646\u064a \u0639\u0646\u062f \u0645\u0643\u062a\u0628 \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644. \u0627\u0644\u0631\u0635\u064a\u062f \u0627\u0644\u0638\u0627\u0647\u0631 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0637\u0644\u0628 \u064a\u062e\u0635 \u0627\u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u0633\u062c\u0644\u0629 \u0633\u0627\u0628\u0642\u064b\u0627\u060c \u0648\u0644\u0627 \u064a\u0636\u064a\u0641 \u0647\u0630\u0627 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0639\u0645\u0644\u064a\u0629 \u0627\u0633\u062a\u0644\u0627\u0645 \u062c\u062f\u064a\u062f\u0629.",
      "\u0633\u062a\u0635\u0644 \u0627\u0644\u0623\u0637\u0628\u0627\u0642 \u0628\u0645\u0644\u0635\u0642 \u064a\u062d\u0645\u0644 \u0631\u0642\u0645 \u0627\u0644\u0637\u0644\u0628 \u0648\u0627\u0633\u0645 \u0627\u0644\u0628\u062f\u064a\u0644 \u0627\u0644\u0646\u0647\u0627\u0626\u064a. \u0627\u062d\u062a\u0641\u0638\u0648\u0627 \u0628\u0627\u0644\u0645\u0644\u0635\u0642\u0627\u062a \u0645\u0639 \u0627\u0644\u0635\u0648\u0627\u0646\u064a \u0644\u062a\u0633\u0647\u064a\u0644 \u062a\u0633\u0644\u064a\u0645\u0647\u0627 \u0625\u0644\u0649 \u0641\u0631\u064a\u0642 \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0645\u0633\u0627\u0626\u064a.",
      "\u0625\u0630\u0627 \u0623\u0631\u0633\u0644 \u0627\u0644\u0645\u0646\u0638\u0645 \u0637\u0644\u0628\u064b\u0627 \u0645\u0646\u0642\u062d\u064b\u0627\u060c \u064a\u062c\u0628 \u0625\u0628\u0644\u0627\u063a \u0641\u0631\u064a\u0642 \u0627\u0644\u062a\u0642\u062f\u064a\u0645 \u0628\u0639\u062f\u062f \u0627\u0644\u062d\u0635\u0635 \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u0642\u0628\u0644 \u0628\u062f\u0621 \u062a\u0648\u0632\u064a\u0639 \u0627\u0644\u0637\u0639\u0627\u0645. \u064a\u0639\u062a\u0645\u062f \u0627\u0644\u0645\u0637\u0628\u062e \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0623\u062d\u062f\u062b \u0645\u0646 \u0627\u0644\u0637\u0644\u0628 \u0641\u0642\u0637.",
      "\u064a\u0631\u062c\u0649 \u062a\u0631\u0643 \u0645\u0633\u0627\u062d\u0629 \u0648\u0627\u0636\u062d\u0629 \u0628\u062c\u0627\u0646\u0628 \u0637\u0627\u0648\u0644\u0629 \u0627\u0644\u062a\u0642\u062f\u064a\u0645 \u0644\u0644\u0623\u0637\u0628\u0627\u0642 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629. \u0644\u0627 \u062a\u0636\u0639\u0648\u0627 \u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u0635\u0648\u0627\u0646\u064a \u0627\u0644\u0641\u0627\u0631\u063a \u0623\u0645\u0627\u0645 \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0643\u0648\u0646\u0627\u062a \u0623\u0648 \u0645\u0633\u0627\u0631 \u0627\u0644\u0636\u064a\u0648\u0641.",
      "\u0628\u0639\u062f \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u062e\u062f\u0645\u0629\u060c \u062a\u0648\u0636\u0639 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0648\u0627\u0644\u0635\u0648\u0627\u0646\u064a \u0627\u0644\u0641\u0627\u0631\u063a\u0629 \u0641\u064a \u0627\u0644\u0645\u0643\u0627\u0646 \u0627\u0644\u0645\u062e\u0635\u0635 \u0642\u0631\u0628 \u0627\u0644\u0628\u0627\u0628 \u0627\u0644\u062c\u0627\u0646\u0628\u064a. \u0633\u064a\u062a\u062d\u0642\u0642 \u0641\u0631\u064a\u0642 \u0627\u0644\u062c\u0645\u0639 \u0645\u0646 \u0627\u0644\u0639\u062f\u062f \u0645\u0639 \u0645\u0646\u0638\u0645 \u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0629 \u0641\u064a \u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u0645\u0633\u0627\u0621."
    ]
