{
  "version": 1,
  "platform": "ios",
  "backend": "snapshot-testing",
  "target": {
    "description": "largest-narrow",
    "sources": [
      "alerttoast/Sources/AlertToast/TransferToastPanel.swift",
      "public/brief.md",
      "public/reference.svg",
      "self-review/fixtures/largest-narrow.json"
    ]
  },
  "environment": {
    "theme": "light",
    "font_scale": 3,
    "layout_direction": "LTR",
    "viewport": "320 x 800",
    "native_output_transport": "common capture.py and warmed native host; iOS AX unavailable",
    "ios_category": "accessibilityExtraExtraExtraLarge"
  },
  "commands": [
    {
      "argv": [
        "python3",
        "capture.py",
        "--platform",
        "ios",
        "--project",
        "alerttoast",
        "--fixture",
        "self-review/fixtures/largest-narrow.json",
        "--output",
        "{output}"
      ],
      "timeout_seconds": 600
    }
  ],
  "artifacts": [
    {
      "base": "output",
      "glob": "native/actual.png",
      "role": "actual"
    },
    {
      "base": "output",
      "glob": "native/native-report.json",
      "role": "native-report"
    },
    {
      "base": "output",
      "glob": "native/capture.json",
      "role": "native-report"
    }
  ],
  "protected_paths": [],
  "checks": [
    {
      "id": "queue-hierarchy",
      "kind": "visual",
      "description": "Quiet card hierarchy, public TQ-LAYOUT and TQ-VIS rules; native-image inspection deferred by D0 protocol",
      "source": "public/brief.md and public/reference.svg"
    },
    {
      "id": "adaptive-colors",
      "kind": "visual",
      "description": "Public palette and state mapping in native rendering; inspection deferred by D0 protocol",
      "source": "public/brief.md TQ-COLOR-01 and TQ-COLOR-02"
    }
  ]
}
