{
  "version": 1,
  "platform": "android",
  "backend": "paparazzi",
  "target": {
    "description": "I06 disclosed-input repair verification",
    "sources": [
      "reply/Reply/app/src/main/java/com/example/reply/ui/components/ReplyTransferPanel.kt",
      "public/brief.md",
      "public/reference.svg",
      "feedback/initial-inputs/I06-input.json"
    ]
  },
  "environment": {
    "theme": "light",
    "font_scale": 1.0,
    "layout_direction": "RTL",
    "viewport": "320 x 620",
    "native_output_transport": "common capture.py and warmed native host; iOS AX unavailable",
    "ios_category": "large"
  },
  "commands": [
    {
      "argv": [
        "python3",
        "capture.py",
        "--platform",
        "android",
        "--project",
        "reply/Reply",
        "--fixture",
        "feedback/initial-inputs/I06-input.json",
        "--output",
        "{output}"
      ],
      "timeout_seconds": 600
    }
  ],
  "artifacts": [
    {
      "base": "output",
      "glob": "native/actual.png",
      "role": "actual"
    },
    {
      "base": "output",
      "glob": "native/native-report.json",
      "role": "native-report"
    },
    {
      "base": "output",
      "glob": "native/capture.json",
      "role": "native-report"
    }
  ],
  "protected_paths": [],
  "checks": [
    {
      "id": "queue-hierarchy",
      "kind": "visual",
      "description": "Quiet card hierarchy, public TQ-LAYOUT and TQ-VIS rules; native-image inspection deferred by D0 protocol",
      "source": "public/brief.md and public/reference.svg"
    },
    {
      "id": "adaptive-colors",
      "kind": "visual",
      "description": "Public palette and state mapping in native rendering; inspection deferred by D0 protocol",
      "source": "public/brief.md TQ-COLOR-01 and TQ-COLOR-02"
    }
  ]
}
