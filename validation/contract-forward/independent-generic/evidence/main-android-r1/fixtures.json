{
  "initial": {
    "title": "Reading set A",
    "footer": "End of reading set A",
    "prefix": "Field note"
  },
  "updates": [
    {
      "title": "Reading set B",
      "footer": "End of reading set B",
      "prefix": "Revised note"
    }
  ],
  "width": 390,
  "theme": "light",
  "fontScale": 1.0,
  "dynamic_type": "large",
  "direction": "ltr",
  "canvas_color": "#F4F7FA",
  "required_identifiers": [
    "reading.heading",
    "reading.footer"
  ],
  "max_scrolls": 18,
  "observation_max_scrolls": 24,
  "trace_reveal_images": true,
  "actions": [
    {
      "type": "tap",
      "target": {
        "identifier": "reading.disclosure"
      },
      "reveal": true,
      "state_id": "opened",
      "after_targets": [
        {
          "identifier": "reading.heading"
        },
        {
          "identifier": "reading.status"
        },
        {
          "identifier": "reading.footer"
        },
        {
          "identifier": "reading.markerA"
        },
        {
          "identifier": "reading.markerB"
        },
        {
          "identifier": "reading.ink"
        }
      ]
    },
    {
      "type": "apply_next_fixture",
      "state_id": "replaced",
      "after_targets": [
        {
          "identifier": "reading.heading"
        },
        {
          "identifier": "reading.status"
        },
        {
          "identifier": "reading.footer"
        },
        {
          "identifier": "reading.markerA"
        },
        {
          "identifier": "reading.markerB"
        },
        {
          "identifier": "reading.ink"
        }
      ]
    }
  ]
}
