      "raw_utf8": "{\n  \"intent\": {\n    \"value\": \"Reading Notes uses a pale canvas, clear heading hierarchy, two blue markers separated by 12 native units, readable untruncated rows, and a readable far footer. Opening notes changes status, preserves the list, and emits one notes.open event. Replacing caller data preserves local open state and emits no callback.\",\n    \"unit\": \"string\"\n  },\n  \"heading\": {\n    \"A\": {\n      \"value\": \"Reading set A\",\n      \"unit\": \"string\"\n    },\n    \"B\": {\n      \"value\": \"Reading set B\",\n      \"unit\": \"string\"\n    }\n  },\n  \"status\": {\n    \"closed\": {\n      \"value\": \"Notes closed\",\n      \"unit\": \"string\"\n    },\n    \"open\": {\n      \"value\": \"Notes open\",\n      \"unit\": \"string\"\n    }\n  },\n  \"footer\": {\n    \"A\": {\n      \"value\": \"End of reading set A\",\n      \"unit\": \"string\"\n    },\n    \"B\": {\n      \"value\": \"End of reading set B\",\n      \"unit\": \"string\"\n    }\n  },\n  \"geometry\": {\n    \"ios\": {\n      \"width\": {\n        \"value\": 72,\n        \"unit\": \"pt\"\n      },\n      \"gap\": {\n        \"value\": 12,\n        \"unit\": \"pt\"\n      },\n      \"tolerance\": {\n        \"value\": 0.75,\n        \"unit\": \"pt\"\n      }\n    },\n    \"android\": {\n      \"width\": {\n        \"value\": 72,\n        \"unit\": \"dp\"\n      },\n      \"gap\": {\n        \"value\": 12,\n        \"unit\": \"dp\"\n      },\n      \"tolerance\": {\n        \"value\": 0.75,\n        \"unit\": \"dp\"\n      }\n    }\n  },\n  \"style\": {\n    \"ink\": {\n      \"value\": \"#FF204B6D\",\n      \"unit\": \"argb\"\n    },\n    \"font\": {\n      \"value\": 16,\n      \"unit\": \"sp\"\n    }\n  },\n  \"events\": {\n    \"open\": {\n      \"value\": [\n        \"notes.open\"\n      ],\n      \"unit\": \"events\"\n    },\n    \"quiet\": {\n      \"value\": [],\n      \"unit\": \"events\"\n    }\n  }\n}\n"
