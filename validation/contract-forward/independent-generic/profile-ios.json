        "python3",
        "/Users/rex/Documents/ChatGPT/mobile-native-skill/validation/contract-forward/independent-generic/stage_verified_observation.py",
        "--run",
        "/Users/rex/Documents/ChatGPT/mobile-native-skill/validation/contract-forward/independent-generic/evidence/main-ios-r1",
        "--fixtures",
        "/Users/rex/Documents/ChatGPT/mobile-native-skill/validation/contract-forward/independent-generic/fixtures.json",
        "--actions",
        "/Users/rex/Documents/ChatGPT/mobile-native-skill/validation/contract-forward/independent-generic/generated-ios/actions.json",
