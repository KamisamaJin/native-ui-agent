{
  "initial": {
    "id": "XFR-4821",
    "title": "Evening transfer for the coastal laboratory",
    "destination": "Coastal rack F / bay 2",
    "temperatureRange": "-22 to -16 °C",
    "sealIntact": true,
    "coolantReady": true,
    "notes": [
      {
        "id": "n1",
        "title": "Check the coastal manifest",
        "body": "Match the seal number to the coastal manifest before moving the crate. Keep a damaged seal in the current freezer and call the receiving technician."
      },
      {
        "id": "n2",
        "title": "Prepare the shelf",
        "body": "Clear the coastal receiving shelf and put its tray within reach. Leave other specimens in their labeled compartments while the new crate is being placed."
      },
      {
        "id": "n3",
        "title": "Keep the lid closed",
        "body": "Carry the crate with its insulated lid latched. Open it inside the receiving cold room after the technician checks the destination and prepares the logger."
      },
      {
        "id": "n4",
        "title": "Follow the indoor route",
        "body": "Use the marked indoor corridor. Ask a colleague to hold the internal door so the crate does not wait beside an exterior entrance."
      },
      {
        "id": "n5",
        "title": "Read the logger",
        "body": "Read the logger with its probe still in the packing sleeve. Record the displayed temperature and arrival time on the manifest before replacing the lid."
      },
      {
        "id": "n6",
        "title": "Separate suspect containers",
        "body": "Put a container with a loose cap or damaged label in the secondary tray. Ask the technician to verify its identity before writing a replacement label."
      },
      {
        "id": "n7",
        "title": "Confirm the handoff",
        "body": "Wait for the technician to acknowledge the crate identifier. This app records the release request; the receiving team completes its separate physical inventory and signature."
      },
      {
        "id": "n8",
        "title": "Leave the paperwork",
        "body": "Place the signed manifest in the cold-room sleeve. Keep the crate identifier facing the aisle so the next shift can find the specimens and their record."
      }
    ]
  },
