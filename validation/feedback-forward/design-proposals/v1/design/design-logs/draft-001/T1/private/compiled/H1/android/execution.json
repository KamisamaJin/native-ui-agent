  "config": {
    "initial": {
      "id": "XFR-9074",
      "title": "Transfer for the high-altitude seed bank",
      "destination": "Reserve rack C / bay 7",
      "temperatureRange": "−24 to −18 °C",
      "sealIntact": true,
      "coolantReady": true,
      "notes": [
        {
          "id": "n1",
          "title": "Prepare the remote inventory",
          "body": "Match the seed-lot labels to the receiving inventory before leaving the staging room. The island store uses separate racks for active conservation material and long-term reserve lots; verify the rack designation with the receiving keeper."
        },
        {
          "id": "n2",
          "title": "Check the padded carrier",
          "body": "Inspect the carrier corners and the insulated insert while the lid remains closed. Replace a wet or torn outer sleeve before departure, and keep the original transit label attached until the receiving keeper has accepted the carrier."
        },
        {
          "id": "n3",
          "title": "Protect the accession tags",
          "body": "Keep the paper accession tags inside their clear sleeves throughout the transfer. Condensation can soften an exposed tag quickly, so use the printed lot number rather than handwriting a replacement from a partly visible label."
        },
        {
          "id": "n4",
          "title": "Coordinate the doorway",
          "body": "Arrange for a second staff member to open the cold-room door before the carrier arrives. Set the carrier on the designated bench instead of on the floor while the receiving keeper confirms the available shelf space."
        },
        {
          "id": "n5",
          "title": "Verify the receiving tray",
          "body": "Use the tray reserved for the listed accession group and check that its divider labels remain legible. A spare tray must be entered in the inventory before any individual containers are moved out of the carrier."
        },
        {
          "id": "n6",
          "title": "Note an unusual reading",
          "body": "If the logger shows an unusual reading, leave the probe and packing in place. Record what the display actually shows and contact the conservation lead before deciding whether the lot can join the normal reserve inventory."
        },
        {
          "id": "n7",
          "title": "Complete the keeper handoff",
          "body": "Wait for the keeper to repeat the carrier identifier and the destination rack. This request records the sender decision, while the receiving team independently signs its inventory record after checking the physical contents of the carrier."
        },
        {
          "id": "n8",
          "title": "Leave the transfer record",
          "body": "Place the completed transfer record in the receiving rack sleeve with the carrier identifier facing outward. Let the next shift know where the reserve lot was placed so that its first scheduled inspection can proceed without searching."
        }
      ]
    },
