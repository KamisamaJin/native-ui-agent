  "config": {
    "initial": {
      "id": "XFR-2618",
      "title": "Transfer to North research freezer",
      "destination": "North rack B / bay 4",
      "temperatureRange": "-20 to -14 °C",
      "sealIntact": true,
      "coolantReady": true,
      "notes": [
        {
          "id": "n1",
          "title": "Check the outer seal",
          "body": "Read the seal number against the paper manifest before moving the crate. If the security strip is torn, keep the crate in its present freezer and contact the receiving technician for a replacement transfer record."
        },
        {
          "id": "n2",
          "title": "Prepare the receiving shelf",
          "body": "Clear the assigned shelf and place the receiving tray within easy reach. Keep unrelated specimens in their labeled compartments so that the new crate can be set down without moving other active research material."
        },
        {
          "id": "n3",
          "title": "Keep the lid closed",
          "body": "Carry the crate with its insulated lid firmly latched. Open it only inside the receiving cold room, after the technician confirms the destination label and has the temperature logger ready for the arrival reading."
        },
        {
          "id": "n4",
          "title": "Use the protected route",
          "body": "Take the marked indoor corridor between the loading room and the cold store. Avoid leaving the crate beside an exterior doorway while waiting for a lift; ask a colleague to hold the internal door instead."
        },
        {
          "id": "n5",
          "title": "Record the logger reading",
          "body": "At the receiving shelf, read the logger without removing its probe from the packing sleeve. Write the displayed value and the time on the manifest, then return the logger to its original position inside the crate."
        },
        {
          "id": "n6",
          "title": "Separate a suspect container",
          "body": "If one container has a loose cap or a damaged label, keep that container in the secondary tray. Do not relabel it from memory. Record its position and ask the receiving technician to confirm the sample identity."
        },
        {
          "id": "n7",
          "title": "Confirm the handoff",
          "body": "Give the receiving technician the manifest and wait for a verbal acknowledgement of the crate identifier. The app records a release request only; the receiving team still completes its normal physical inventory and handoff procedure."
        },
        {
          "id": "n8",
          "title": "Store the paperwork",
          "body": "Leave the signed manifest in the cold-room document sleeve after the handoff is complete. Keep the crate identifier visible at the front of the shelf so the next shift can find both the specimens and their record."
        }
      ]
    },
