  "config": {
    "initial": {
      "id": "TOUR-516",
      "title": "The sound of craft: a walk through the textile galleries",
      "language": "English · textile collection",
      "downloadSizeMB": 196,
      "availableMB": 440,
      "meteredConnection": true,
      "chapters": [
        {
          "id": "n1",
          "title": "The first spinning wheel",
          "body": "Begin beside the spinning wheel and examine the worn treadle. A weaver describes learning to keep the thread steady while watching the changing bundle of fiber."
        },
        {
          "id": "n2",
          "title": "Choosing a fiber",
          "body": "At the fiber cabinet, compare the wool and flax samples. This chapter explains how their different textures influenced the cloth a workshop could make."
        },
        {
          "id": "n3",
          "title": "Colors from the garden",
          "body": "Listen beside the dye pots to learn how plants produced familiar colors. Look for the small sample cards that record each workshop recipe."
        },
        {
          "id": "n4",
          "title": "Setting the loom",
          "body": "Stand near the large loom and follow the line of its threads. The narrator describes preparing a pattern before the first row of cloth was woven."
        },
        {
          "id": "n5",
          "title": "A pattern shared",
          "body": "The pattern books preserve ideas passed between makers. Pause at the open page while a designer explains adapting a familiar motif for a new commission."
        },
        {
          "id": "n6",
          "title": "Mending a favorite coat",
          "body": "At the mending table, listen to a repairer describe choosing a patch. The nearby coat shows how careful work can preserve a garment for another generation."
        },
        {
          "id": "n7",
          "title": "Cloth at the market",
          "body": "The market display follows a finished bolt from workshop to customer. Short memories describe measuring, bargaining, and choosing fabric for a special family occasion."
        },
        {
          "id": "n8",
          "title": "Makers working today",
          "body": "Finish beside the contemporary textiles. The closing voices describe the tools they still use and invite you to compare their work with the older cloth nearby."
        }
      ]
    },
