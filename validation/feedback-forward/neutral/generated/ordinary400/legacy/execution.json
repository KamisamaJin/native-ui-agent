    "initial": {
      "title": "Observation notes",
      "summary": "Ten short notes form one continuous reading sequence. Review them once, then compare the replacement revision.",
      "revision": "A",
      "can_review": true,
      "sections": [
        {
          "number": 1,
          "title": "Opening note",
          "body": "Start with a single purpose. Keep the opening note specific enough to recognize later."
        },
        {
          "number": 2,
          "title": "Scope note",
          "body": "Name the edges of the work. A short boundary makes the rest of the notes easier to read."
        },
        {
          "number": 3,
          "title": "Order note",
          "body": "Put the next useful idea after the current one. Readers should be able to follow the sequence."
        },
        {
          "number": 4,
          "title": "Detail note",
          "body": "Keep one concrete detail close to each main point. Separate details that serve different purposes."
        },
        {
          "number": 5,
          "title": "Pause note",
          "body": "Leave a clear pause between groups. A little space helps the reader find the next section."
        },
        {
          "number": 6,
          "title": "Review note",
          "body": "Read the notes once from top to bottom. Mark the review only after considering the whole sequence."
        },
        {
          "number": 7,
          "title": "Continuity note",
          "body": "Keep the current review count when the caller supplies a new revision of these notes."
        },
        {
          "number": 8,
          "title": "Context note",
          "body": "A replacement can change the title and summary while leaving the same component mounted."
        },
        {
          "number": 9,
          "title": "Reach note",
          "body": "The final sections should remain reachable. Long content must keep its ordinary reading order."
        },
        {
          "number": 10,
          "title": "Closing note",
          "body": "Finish with a clear end note. The revision and review count should agree with the current state."
