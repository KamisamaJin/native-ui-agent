  "config": {
    "initial": {
      "id": "TOUR-203",
      "title": "Harbor museum: voices of the working port",
      "language": "English · harbor collection",
      "downloadSizeMB": 128,
      "availableMB": 320,
      "meteredConnection": true,
      "chapters": [
        {
          "id": "n1",
          "title": "At the harbor gate",
          "body": "Begin beside the old harbor gate and listen for the bell that once announced a vessel arriving at the quay. The introduction describes how workers coordinated a busy waterfront before radios became part of everyday port life."
        },
        {
          "id": "n2",
          "title": "The rope makers",
          "body": "Walk toward the long rope-making bench and compare the tools displayed above it. This chapter follows a small team preparing a heavy line, with pauses that let you examine the fibers and the worn wooden handles nearby."
        },
        {
          "id": "n3",
          "title": "A shipwright workshop",
          "body": "Stand beside the half-built hull and look along the curve of its ribs. The shipwright describes choosing timber, checking a joint, and teaching an apprentice to notice a small gap before the outer planks were fitted."
        },
        {
          "id": "n4",
          "title": "Work at the fish market",
          "body": "The market gallery brings together sellers, carriers, and the people who repaired baskets at the end of the day. Listen beside the weighing table, then look for the chalk price board before continuing into the next room."
        },
        {
          "id": "n5",
          "title": "Signals across the water",
          "body": "At the signal cabinet, the narrator explains why a clear message mattered in poor weather. Short examples describe the flags and lamps without requiring you to identify every symbol, so you can listen while examining the original equipment."
        },
        {
          "id": "n6",
          "title": "The engine room",
          "body": "Pause near the engine model and follow the route from the boiler to the propeller shaft. A mechanic recalls the rhythm of routine checks and explains how the crew recognized a change in the sound of a working engine."
        },
        {
          "id": "n7",
          "title": "Letters from the voyage",
          "body": "The writing desk holds copies of letters sent home during long trips. This chapter reads brief passages about ordinary meals, changing weather, and missing family, with quiet intervals that give you time to inspect the handwriting on display."
        },
        {
          "id": "n8",
          "title": "A changing waterfront",
          "body": "Finish at the large window overlooking the present harbor. The final voices discuss new jobs and familiar landmarks, inviting you to compare the view outside with the historical photographs on the adjacent wall before you leave the gallery."
        }
      ]
    },
